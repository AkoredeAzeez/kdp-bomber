# Generated book output and runtime state -- these live on the Railway
# volume (see deploy/entrypoint.sh), not in source control. Same reasoning
# as .dockerignore: this repo is the Genie framework/code, not your books.
Books/
state/
cover_db/
catalog/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/

# OS/editor cruft
.DS_Store
Thumbs.db

# Per-person Railway provisioning config/output (auth tokens + book briefs
# in, generated API tokens + domains out) -- local only, never committed.
deploy/people.local.json
deploy/provisioned.local.json
