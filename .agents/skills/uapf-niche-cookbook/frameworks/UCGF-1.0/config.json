{
  "framework_id": "UCGF 1.0",
  "niche": "uapf-niche-cookbook",
  "overlay": "OV-COOK",
  "source_of_truth": "../../SKILL.md",

  "interior": {
    "trim_in": [8.625, 11.25],
    "margins_in": 0.7,
    "folio": "bottom-center",
    "body_font": "Times New Roman",
    "body_pt": 11,
    "color_count": 2,
    "color_roles": ["primary", "accent"],
    "body_text_color": "black",
    "full_color": true
  },

  "recipe_layout": {
    "recipes_per_page": 2,
    "recipe_never_splits": true,
    "archetypes": ["A_compact_two_column", "B_full_width_stacked"],
    "mix_archetypes_within_book": false,
    "method_restarts_at_1": true,
    "photo_per_recipe": true
  },

  "layout_fit_budget": {
    "rule": "A recipe plus its photo fills 80-90% of its column and NEVER spills past the column or the page margins; rewrite to fit, never resize type below 11pt or overflow.",
    "archetype_A_compact_two_column": {
      "column_fill_target_pct": [80, 90],
      "ingredient_line_max_chars": 42,
      "ingredient_lines_should_not_wrap": true,
      "method_steps_max": 5,
      "method_step_target_lines": [1, 2],
      "photo_width_in": 2.85,
      "enforced_by": "render-QA gate (uapf-quality-gates/render_qa.py)"
    },
    "generation_directive": "Author recipe text to the fit budget above so two recipes fit one page in the chosen archetype. Concise, one-line ingredients and tight numbered steps. Do NOT emit content that overflows a column."
  },

  "categories": {
    "min_count": 8,
    "max_count": 12,
    "recipes_per_category_min": 6,
    "recipes_per_category_max": 15,
    "must_cover": ["breakfast", "lunch", "dinner", "snack"],
    "prefer_single_noun": true
  },

  "meal_plan": {
    "default_days": 30,
    "optional_days": 60,
    "every_cell_is_book_recipe": true
  },

  "nutrition": {
    "theme_nutrient_ends_per_serving": true,
    "calorie_round_to": 5,
    "macro_round_to_g": 1,
    "base_values": "USDA FoodData Central"
  },

  "safe_temperatures": {
    "poultry_f": 165, "poultry_c": 74,
    "fish_f": 145, "fish_c": 63,
    "refrigeration_max_f": 40, "refrigeration_max_c": 4
  },

  "metric_conversions": {
    "tsp_ml": 5, "tbsp_ml": 15, "cup_liquid_ml": 240,
    "weights": "ingredient-specific from USDA gram equivalents, never a flat guess"
  },

  "page_governor": {
    "front_matter_pages": 6,
    "intro_plus_education_pages": 6,
    "dividers_pages_equals_category_count": true,
    "recipe_pages_formula": "ceil(recipe_count / 2)",
    "conclusion_pages": 2,
    "appendix_pages": {"30": 12, "60": 20},
    "formula": "6 + 6 + C + ceil(R/2) + 2 + A"
  },

  "page_budget": {
    "studio_owner_hard_cap": 100,
    "client_default": 100,
    "client_may_raise": true,
    "deployment_marker": ".genie_owner",
    "compression_order_on_breach": ["appendix_density", "educational_depth_6_to_4", "recipe_count"]
  },

  "image_contract": {
    "hero_slot": "IMG-00",
    "divider_slot_pattern": "IMG-D-<CATEGORY>",
    "recipe_slot_pattern": "IMG-Rnn",
    "count_formula": "1 + category_count + recipe_count",
    "generator": "uapf-flow-image-pipeline"
  },

  "content_rules": {
    "no_pork": true,
    "no_alcohol": true,
    "exclusion_is_silent": true,
    "no_em_dashes": true,
    "no_third_party_brands": true,
    "locked_title_immutable": true
  },

  "deliverable": {
    "format": "DOCX",
    "native_styles": true,
    "live_auto_toc": true,
    "plain_text_or_pdf_only": "FAIL"
  }
}
